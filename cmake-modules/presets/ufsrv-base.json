{
  "version": 6,
  "configurePresets": [
    {
      "name": "ufsrv-base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UFSRV_BUILD_WITH_COVERAGE": "OFF",
        "UFSRV_COMPANION_PROVIDER": "system-installed",
        "UFSRV_CONFIG_COMPOSE": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (no sanitizers)",
      "inherits": "ufsrv-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (-O3)",
      "inherits": "ufsrv-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "insource",
      "displayName": "In-source companion libraries",
      "inherits": "ufsrv-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UFSRV_COMPANION_PROVIDER": "in-source"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "insource",
      "configurePreset": "insource"
    }
  ]
}
